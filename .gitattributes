# Normalize all text files to LF in the repo and in the working tree, on every OS.
* text=auto eol=lf

# Binary assets: never touch line endings or diff as text.
*.npz binary
*.mat binary
*.wav binary
*.mp3 binary
*.m4a binary
*.flac binary
*.ogg binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
